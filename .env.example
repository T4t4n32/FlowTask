# Copia este archivo como .env y rellena los valores. El .env real NO se sube a git.

# --- Telegram ---
# Token que te da @BotFather al crear el bot.
TELEGRAM_TOKEN=

# --- IA (Google Gemini) ---
# Clave de https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo a usar (opcional). Por defecto: gemini-1.5-flash
GEMINI_MODEL=gemini-1.5-flash

# --- Base de datos ---
# Local (por defecto si se deja vacío): sqlite:///./flowtask.db
# Supabase (Task 3): cadena del "Transaction pooler", puerto 6543, de
#   Supabase > Project Settings > Database > Connection string > Transaction pooler
DATABASE_URL=
